# =====================================================================
# Serenity 2.0 Environment Configuration Template
# Copy this file to .env and fill in your secrets.
# NEVER commit your actual .env file to version control!
# =====================================================================

# Groq API Key (required for LLM conversation & speech-to-text)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Connection URL (Asyncpg dialect)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Default PostgreSQL port is 5432
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/serenity

# JWT Secret Key for token signing (generate a strong random secret in production)
SECRET_KEY=serenity_super_secret_jwt_key_2026_change_in_production

# Optional Model Overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
